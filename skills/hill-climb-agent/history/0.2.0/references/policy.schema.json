{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.agent-skills/hill-climb-agent/policy.schema.json",
  "title": "Agent hill-climb policy, format 1",
  "type": "object",
  "required": ["format_version", "skill_version", "target_agent", "goal", "parent_selection", "analysis", "allowed_iteration_files", "datasets", "fixed", "paths", "metric_keys"],
  "properties": {
    "format_version": {"const": 1},
    "skill_version": {"type": "string", "minLength": 1},
    "target_agent": {"type": "string", "minLength": 1},
    "goal": {"type": "string", "minLength": 1},
    "parent_selection": {"type": "string", "minLength": 1},
    "analysis": {
      "type": "object",
      "required": ["source_split", "required_before_child", "min_failed_evidence_ids", "required_fields"],
      "properties": {
        "source_split": {"const": "train"},
        "required_before_child": {"const": true},
        "min_failed_evidence_ids": {"type": "integer", "minimum": 1},
        "required_fields": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": true
    },
    "allowed_iteration_files": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"}},
    "backend_modes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "datasets": {
      "type": "object",
      "required": ["train", "eval", "manifest"],
      "properties": {
        "train": {"$ref": "#/$defs/repoPath"},
        "eval": {"$ref": "#/$defs/repoPath"},
        "manifest": {"$ref": "#/$defs/repoPath"},
        "held_out": {"$ref": "#/$defs/repoPath"}
      },
      "additionalProperties": true
    },
    "fixed": {
      "type": "object",
      "required": ["metric_contract", "shared_library"],
      "properties": {
        "split_manifest": {"$ref": "#/$defs/repoPath"},
        "model_config": {"$ref": "#/$defs/repoPath"},
        "metric_contract": {"$ref": "#/$defs/repoPath"},
        "shared_library": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/repoPath"}}
      },
      "additionalProperties": true
    },
    "paths": {
      "type": "object",
      "required": ["iterations", "analyses", "best", "outputs", "baseline_prompt"],
      "properties": {
        "iterations": {"$ref": "#/$defs/repoPath"},
        "analyses": {"$ref": "#/$defs/repoPath"},
        "best": {"$ref": "#/$defs/repoPath"},
        "outputs": {"$ref": "#/$defs/repoPath"},
        "baseline_prompt": {"$ref": "#/$defs/repoPath"},
        "baseline_schema": {"$ref": "#/$defs/repoPath"},
        "baseline_backend": {"$ref": "#/$defs/repoPath"}
      },
      "additionalProperties": true
    },
    "metric_keys": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {"repoPath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"}},
  "additionalProperties": true
}
