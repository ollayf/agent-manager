# The ONE machine-local file for agent-manager. Copy to secrets.env (gitignored, chmod 600)
# and fill in real values. To set up another machine, copy your secrets.env next to the new
# clone and run ./install.sh. This example is committed, so it holds placeholders only.
#
# Consumers:
#   shell/claude.zsh  sources it; only `export` lines reach child processes.
#   install.sh        renders ~/.claude/mode-configs/*.json from config/mode-configs/*.template.json.
#   bin/agent-mcp     reads the variables named in config/shared/mcp.json (env / bearer_token_env).
# After changing a value, re-run ./install.sh. An MCP server that already exists is not
# rewritten: remove it (claude mcp remove <name>) and re-run to rotate its token.

# ---------------------------------------------------------------- model providers
# BytePlus ark endpoint (use-glm)
GLM_ARK_TOKEN=ark-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx-xxxxx

# z.ai endpoint (mode-configs/glm-2.json) and the z.ai MCP servers web-search-prime / web-reader
GLM_ZAI_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.xxxxxxxxxxxxxxxx

# ---------------------------------------------------------------- tools
# browser-use, exported into the shell
export BROWSER_USE_API_KEY=<your-browser-use-api-key>

# Brave Search API (only needed if you add a brave-search MCP server)
BRAVE_API_KEY=<your-brave-api-key>

# ---------------------------------------------------------------- skills (optional)
# telegram-me: on macOS the Keychain items telegram-me-bot-token / telegram-me-chat-id are
# preferred. Uncomment on machines without Keychain (Linux, containers).
# export TELEGRAM_ME_BOT_TOKEN=0000000000:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# export TELEGRAM_ME_CHAT_ID=000000000

# archive-general: storage targets are registered per machine with `archive.py target add`
# (saved in ~/.config/archive-general/targets.json, bound to the drive's identity), not here.
# Only the eval harness reads this:
# export ARCHIVE_GENERAL_EVAL_SSD=/Volumes/<SSD name>/Archives
