# Copy to secrets.env and fill in real values. This file is safe to commit.
# Consumed by shell/claude.zsh (exports) and install.sh (renders mode-configs).
# After changing a value, re-run ./install.sh to re-render ~/.claude/mode-configs/.

# BytePlus ark endpoint (use-glm)
GLM_ARK_TOKEN=ark-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx-xxxxx

# z.ai endpoint (mode-configs/glm-2.json)
GLM_ZAI_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.xxxxxxxxxxxxxxxx

# browser-use, exported into the shell
export BROWSER_USE_API_KEY=bu_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
