#!/usr/bin/env bash
# Reconcile portable, secret-free MCP intent into Claude Code and Codex.
set -euo pipefail

REPO="$(python3 -c 'import os,sys; print(os.path.dirname(os.path.dirname(os.path.realpath(sys.argv[1]))))' "${BASH_SOURCE[0]}")"
# shellcheck source=../lib/common.sh
source "$REPO/lib/common.sh"
MANIFEST="${AGENT_MCP_MANIFEST:-$REPO/config/shared/mcp.json}"
SECRETS_FILE="${AGENT_SECRETS_FILE:-$REPO/secrets.env}"

usage() { echo "usage: agent-mcp sync|status [--dry-run]"; exit "${1:-0}"; }

ARGS=()
for arg in "$@"; do case "$arg" in --dry-run) DRY_RUN=1 ;; *) ARGS+=("$arg") ;; esac; done
set -- ${ARGS+"${ARGS[@]}"}

server_names() { jq -r '.servers | keys[]' "$MANIFEST"; }
server_has_agent() { jq -e --arg n "$1" --arg a "$2" '(.servers[$n].agents // ["claude","codex"]) | index($a) != null' "$MANIFEST" >/dev/null; }

validate_manifest() {
  jq -e '.version == 1 and (.servers | type == "object")' "$MANIFEST" >/dev/null || { fail "invalid MCP manifest"; return 1; }
  local bad
  bad="$(jq -r '.servers | to_entries[] | .key as $n | (.value.env // {}) | to_entries[] | select(.value | test("^[A-Z][A-Z0-9_]*$") | not) | $n + ":" + .key' "$MANIFEST")"
  [ -z "$bad" ] || { fail "MCP env mappings must name environment variables, not literal secrets: $bad"; return 1; }
  bad="$(jq -r '.servers | to_entries[] | select((.value.bearer_token_env // "X") | test("^[A-Z][A-Z0-9_]*$") | not) | .key' "$MANIFEST")"
  [ -z "$bad" ] || { fail "bearer_token_env must name an environment variable: $bad"; return 1; }
  # Literal headers would put a credential in git; only the named-variable form is supported.
  bad="$(jq -r '.servers | to_entries[] | select(.value.headers != null) | .key' "$MANIFEST")"
  [ -z "$bad" ] || { fail "MCP 'headers' are not supported (use bearer_token_env): $bad"; return 1; }
}

# A credential comes from the environment first, then from the gitignored secrets.env.
# Never echo the value: callers pass it straight to the agent CLI.
secret_value() {
  local key="$1"
  if [ -n "${!key-}" ]; then printf '%s' "${!key}"; return 0; fi
  [ -f "$SECRETS_FILE" ] || return 0
  python3 - "$REPO/lib" "$SECRETS_FILE" "$key" <<'PY_SECRET'
import sys
sys.path.insert(0, sys.argv[1])
from render import load_env
sys.stdout.write(load_env(sys.argv[2]).get(sys.argv[3], ""))
PY_SECRET
}

# Like run(), but a dry run prints a redacted description instead of the real arguments.
run_secret() {
  local shown="$1"; shift
  if [ "$DRY_RUN" = 1 ]; then
    _PENDING=$((_PENDING+1))
    printf '  %sdry%s  %s\n' "$C_YEL" "$C_OFF" "$shown"
  else
    "$@"
  fi
}

add_server() {
  local agent="$1" name="$2" transport url command env_key host_key value bearer
  transport="$(jq -r --arg n "$name" '.servers[$n].transport' "$MANIFEST")"
  if [ "$transport" = http ]; then
    url="$(jq -r --arg n "$name" '.servers[$n].url' "$MANIFEST")"
    bearer="$(jq -r --arg n "$name" '.servers[$n].bearer_token_env // empty' "$MANIFEST")"
    if [ -z "$bearer" ]; then
      if [ "$agent" = claude ]; then run claude mcp add --scope user --transport http "$name" "$url"
      else run codex mcp add "$name" --url "$url"; fi
    elif [ "$agent" = claude ]; then
      # Claude stores the rendered header in its own machine-local config.
      value="$(secret_value "$bearer")"
      [ -n "$value" ] || { fail "$name: $bearer is not set in the environment or $(shortp "$SECRETS_FILE")"; return 1; }
      run_secret "claude mcp add --scope user --transport http $name $url --header 'Authorization: Bearer \${$bearer}'" \
        claude mcp add --scope user --transport http "$name" "$url" --header "Authorization: Bearer $value"
    else
      # Codex reads the variable at runtime, so nothing secret is written to its config.
      run codex mcp add "$name" --url "$url" --bearer-token-env-var "$bearer"
    fi
    return
  fi
  [ "$transport" = stdio ] || { fail "$name: transport must be http or stdio"; return 1; }
  command="$(jq -r --arg n "$name" '.servers[$n].command' "$MANIFEST")"
  local -a args=() env_args=()
  while IFS= read -r value; do args+=("$value"); done < <(jq -r --arg n "$name" '.servers[$n].args // [] | .[]' "$MANIFEST")
  while IFS=$'\t' read -r host_key env_key; do
    [ -n "$host_key" ] || continue
    value="$(secret_value "$env_key")"
    [ -n "$value" ] || { fail "$name: $env_key is not set in the environment or $(shortp "$SECRETS_FILE")"; return 1; }
    if [ "$agent" = claude ]; then env_args+=("-e" "$host_key=$value"); else env_args+=("--env" "$host_key=$value"); fi
  done < <(jq -r --arg n "$name" '.servers[$n].env // {} | to_entries[] | [.key,.value] | @tsv' "$MANIFEST")
  if [ "$agent" = claude ]; then
    run_secret "claude mcp add --scope user $name <${#env_args[@]} env args redacted> -- $command ${args[*]}" \
      claude mcp add --scope user "$name" ${env_args[@]+"${env_args[@]}"} -- "$command" ${args[@]+"${args[@]}"}
  else
    run_secret "codex mcp add <${#env_args[@]} env args redacted> $name -- $command ${args[*]}" \
      codex mcp add ${env_args[@]+"${env_args[@]}"} "$name" -- "$command" ${args[@]+"${args[@]}"}
  fi
}

sync_agent() {
  local agent="$1" cli="$1" name
  [ "$agent" = claude ] || cli=codex
  command -v "$cli" >/dev/null 2>&1 || { warn "$agent CLI missing — MCP sync deferred"; return 0; }
  while read -r name; do
    [ -n "$name" ] || continue
    server_has_agent "$name" "$agent" || continue
    if "$cli" mcp get "$name" >/dev/null 2>&1; then info "$agent MCP $name: present"
    elif [ "$DRY_RUN" = 1 ]; then run "add $agent MCP server $name"
    else add_server "$agent" "$name" && ok "$agent MCP $name added"; fi
  done < <(server_names)
}

cmd_status() {
  validate_manifest
  local name agent cli state
  while read -r name; do
    for agent in claude codex; do
      server_has_agent "$name" "$agent" || continue
      cli="$agent"; command -v "$cli" >/dev/null 2>&1 || { warn "$agent MCP $name: CLI missing"; continue; }
      if "$cli" mcp get "$name" >/dev/null 2>&1; then state=present; else state=missing; fi
      info "$agent MCP $name: $state"
    done
  done < <(server_names)
}

case "${1:-}" in
  sync) validate_manifest; sync_agent claude || true; sync_agent codex || true; failures ;;
  status) cmd_status ;;
  -h|--help|help|"") usage 0 ;;
  *) usage 2 ;;
esac
