#!/usr/bin/env python3
"""Move Claude Code and Codex conversations and memory to another machine.

    agent-state export [--out DIR] [--project PATH ...] [--dry-run] [--no-redact]
    agent-state verify BUNDLE
    agent-state import BUNDLE [--apply] [--map OLD=NEW ...] [--reindex-codex]
    agent-state pack   BUNDLE            (macOS: encrypted, compressed .dmg)

Export only reads the agents' folders. It writes one bundle folder, grouped by project, with
known token shapes and the values in secrets.env redacted. Import previews by default, never
overwrites an existing file, and backs up every file it merges.

Logins, OAuth tokens, settings, trust records, caches and the agents' own databases are never
exported: they are machine-local and are recreated by logging in on the new machine.
"""
import argparse
import datetime as dt
import hashlib
import json
import os
import re
import shutil
import socket
import subprocess
import sys
from pathlib import Path

FORMAT = 1
REPO = Path(__file__).resolve().parents[1]
EXPORTS = REPO / "exports"  # the default; gitignored, and the only place inside the repo we write
sys.path.insert(0, str(REPO / "lib"))
from render import load_env  # noqa: E402

CLAUDE_GLOBAL_DIRS = ("file-history", "paste-cache", "plans", "tasks")
CODEX_SESSION_DIRS = ("sessions", "archived_sessions")
PROJECT_FILES = ("CLAUDE.local.md", "CLAUDE.md", "AGENTS.md")  # CLAUDE.local.md is always local
SKIP_NAMES = {".DS_Store"}
MAX_SLUG = 200  # Claude Code hashes longer project paths; we only keep those verbatim.

# Transcript-only token shapes, on top of the commit guard's list in lib/credscan.sh.
EXTRA_PATTERNS = [
    ("private key block", rb"-----BEGIN [A-Z ]*PRIVATE KEY-----[A-Za-z0-9+/=\s\\]*?-----END [A-Z ]*PRIVATE KEY-----"),
    ("OpenAI key", rb"sk-(?:proj-|svcacct-)?[A-Za-z0-9_-]{32,}"),
    ("Google API key", rb"AIza[0-9A-Za-z_-]{35}"),
    ("Slack token", rb"xox[abprs]-[A-Za-z0-9-]{10,}"),
    ("Telegram bot token", rb"(?<![0-9])[0-9]{8,10}:AA[A-Za-z0-9_-]{33}"),
    ("JWT", rb"eyJ[A-Za-z0-9_-]{10,}\.eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}"),
]


# A token starts after a non-token character or a JSON escape (\n, \r, \t) and ends before one.
# Without these edges the shapes match inside base64 images and long identifiers.
LEFT_EDGE = rb"(?:(?<![A-Za-z0-9+/_-])|(?<=\\[nrt]))"
RIGHT_EDGE = rb"(?![A-Za-z0-9+/_-])"


def die(msg):
    print(f"agent-state: {msg}", file=sys.stderr)
    sys.exit(1)


def home():
    return Path(os.environ["HOME"])


def codex_home():
    return Path(os.environ.get("CODEX_HOME") or home() / ".codex")


def claude_roots():
    """(profile name, config dir) for primary Claude and every claude-profile."""
    roots = [("main", home() / ".claude")]
    profiles = home() / ".claude-profiles"
    if profiles.is_dir():
        roots += [(p.name, p) for p in sorted(profiles.iterdir()) if p.is_dir() and not p.is_symlink()]
    return [(n, r) for n, r in roots if r.is_dir()]


def slugify(path):
    return re.sub(r"[^A-Za-z0-9]", "-", str(path))


def git_ignored(path):
    """True when git would ignore path, or when the repo is not a git checkout (nothing to
    commit into). Any other git failure counts as not ignored: this guard must fail closed."""
    try:
        inside = subprocess.run(["git", "-C", str(REPO), "rev-parse", "--is-inside-work-tree"],
                                capture_output=True, text=True)
    except FileNotFoundError:
        return True  # no git on this machine, so no commit can pick the bundle up
    if inside.returncode != 0 or inside.stdout.strip() != "true":
        return True
    r = subprocess.run(["git", "-C", str(REPO), "check-ignore", "-q", "--no-index", str(path)],
                       capture_output=True)
    return r.returncode == 0


def is_within(path, parent):
    try:
        Path(path).resolve().relative_to(Path(parent).resolve())
        return True
    except ValueError:
        return False


# ---------------------------------------------------------------- secret scanning

class Scanner:
    """Finds token shapes and this machine's own secret values; never stores a value."""

    def __init__(self, redact=True):
        self.redact = redact
        self.patterns = []
        text = (REPO / "lib/credscan.sh").read_text()
        block = text.split("CREDSCAN_PATTERNS=(", 1)[1].split("\n)", 1)[0]
        shapes = [(label.strip(), pat.replace("[[:space:]]", r"\s").encode())
                  for pat, label in re.findall(r"^\s*'([^']*)'\s*#\s*(.*)$", block, re.M)]
        for label, pat in shapes + EXTRA_PATTERNS:
            quick = re.compile(pat)  # keeps the regex engine's fast literal-prefix search
            exact = quick
            if pat[:1].isalnum():  # a bare token must stand alone, not sit inside base64 or a longer name
                exact = re.compile(LEFT_EDGE + b"(?:" + pat + b")" + RIGHT_EDGE)
            self.patterns.append((label, quick, exact))
        placeholder = re.search(r"CREDSCAN_PLACEHOLDER='([^']*)'", text).group(1)
        self.placeholder = re.compile(placeholder.encode())
        self.literals = []
        secrets = Path(os.environ.get("AGENT_SECRETS_FILE") or REPO / "secrets.env")
        if secrets.is_file():
            for key, value in load_env(secrets).items():
                for v in {value, os.environ.get(key, "")}:
                    if len(v) >= 12 and not self.placeholder.search(v.encode()):
                        self.literals.append((f"secrets.env {key}", v.encode()))
        self.findings = []  # (bundle path, line, detector, action)

    def spans(self, line):
        found = []
        for label, value in self.literals:
            start = line.find(value)
            while start >= 0:
                found.append((start, start + len(value), label))
                start = line.find(value, start + 1)
        for label, quick, exact in self.patterns:
            if not quick.search(line):
                continue
            for m in exact.finditer(line):
                if not self.placeholder.search(m.group()):
                    found.append((m.start(), m.end(), label))
        found.sort()
        merged = []
        for s, e, label in found:
            if merged and s < merged[-1][1]:
                merged[-1] = (merged[-1][0], max(e, merged[-1][1]), merged[-1][2])
            else:
                merged.append((s, e, label))
        return merged

    def process(self, line, where, lineno):
        spans = self.spans(line)
        if not spans:
            return line
        out, last = [], 0
        for s, e, label in spans:
            chunk = line[s:e]
            # Replacing a span that holds a quote would break the JSON line; flag it instead.
            safe = self.redact and b'"' not in chunk and (b"\\" not in chunk or label == "private key block")
            self.findings.append((where, lineno, label, "redacted" if safe else "REVIEW: kept as-is"))
            if safe:
                tag = re.sub(r"[^A-Za-z0-9 ._-]", "", label)
                out += [line[last:s], b"[REDACTED:" + tag.encode() + b"]"]
                last = e
        out.append(line[last:])
        return b"".join(out)


def is_binary(path):
    with open(path, "rb") as fh:
        return b"\0" in fh.read(8192)


# ---------------------------------------------------------------- reading agent state

def first_cwd(path, limit=60):
    """Working directory recorded in a Claude transcript or Codex rollout."""
    try:
        with open(path, "rb") as fh:
            for i, raw in enumerate(fh):
                if i >= limit:
                    break
                if b'"cwd"' not in raw:
                    continue
                try:
                    rec = json.loads(raw)
                except ValueError:
                    continue
                cwd = rec.get("cwd") or (rec.get("payload") or {}).get("cwd")
                if isinstance(cwd, str) and cwd.startswith("/"):
                    return cwd
    except OSError:
        pass
    return None


def resolve_slug(slug, known):
    """Turn a lossy Claude project slug back into a path: recorded paths first, then the disk."""
    hits = sorted(p for p in known if slugify(p) == slug)
    if hits:
        return hits[0]

    def walk(directory, built, depth):
        if built == slug:
            return directory
        if depth > 14:
            return None
        try:
            children = sorted(os.scandir(directory), key=lambda e: e.name)
        except OSError:
            return None
        for child in children:
            if not child.is_dir(follow_symlinks=False):
                continue
            s = built + "-" + slugify(child.name)
            if slug == s or slug.startswith(s + "-"):
                found = walk(child.path, s, depth + 1)
                if found:
                    return found
        return None

    return walk("/", "", 0)


def display_name(path, slug):
    if path is None:
        return "_unresolved__" + slug.strip("-")
    p = Path(path)
    try:
        rel = p.relative_to(home())
        return "__".join(rel.parts) or "_home"
    except ValueError:
        return "_root__" + "__".join(p.parts[1:])


def git_facts(path):
    def git(*args):
        r = subprocess.run(["git", "-C", str(path), *args], capture_output=True, text=True)
        return r.returncode, r.stdout.strip()

    rc, top = git("rev-parse", "--show-toplevel")
    if rc:
        return {"repo": False}
    _, remotes = git("remote")
    _, status = git("status", "--porcelain=v1", "--branch")
    head = status.splitlines()[0] if status else ""
    return {
        "repo": True,
        "root": top,
        "remote": bool(remotes),
        "unpushed": "ahead" in head or ("..." not in head and bool(remotes)),
        "dirty": len(status.splitlines()) > 1,
    }


def local_project_files(path, git):
    """Project instruction files that will not arrive through git."""
    picked = []
    for name in PROJECT_FILES:
        f = Path(path) / name
        if not f.is_file() or f.is_symlink():
            continue
        if name == "CLAUDE.local.md" or not git.get("repo"):
            picked.append(f)
            continue
        tracked = subprocess.run(["git", "-C", str(path), "ls-files", "--error-unmatch", name],
                                 capture_output=True).returncode == 0
        clean = subprocess.run(["git", "-C", str(path), "diff", "--quiet", "HEAD", "--", name],
                               capture_output=True).returncode == 0
        if not (tracked and clean):
            picked.append(f)
    return picked


def collect(only):
    """Plan the export: {project key: {...}} plus global items. Reads, never writes."""
    known = set()
    claude_dirs = []  # (slug, dir)
    for _, root in claude_roots():
        projects = root / "projects"
        if projects.is_dir() and not projects.is_symlink():
            claude_dirs += [(d.name, d) for d in sorted(projects.iterdir()) if d.is_dir()]
        hist = root / "history.jsonl"
        if hist.is_file() and not hist.is_symlink():
            with open(hist, "rb") as fh:
                for raw in fh:
                    try:
                        p = json.loads(raw).get("project")
                    except ValueError:
                        continue
                    if isinstance(p, str) and p.startswith("/"):
                        known.add(p)

    codex = []
    for sub in CODEX_SESSION_DIRS:
        base = codex_home() / sub
        if base.is_dir():
            for f in sorted(base.rglob("rollout-*.jsonl")):
                if f.is_file():
                    cwd = first_cwd(f)
                    codex.append((f, cwd))
                    if cwd:
                        known.add(cwd)

    projects = {}

    def project(path, slug):
        key = path or "slug:" + slug
        if key not in projects:
            projects[key] = {"path": path, "slug": slug or slugify(path),
                             "claude": [], "codex": [], "files": []}
        return projects[key]

    for slug, d in claude_dirs:
        cwds = [c for c in (first_cwd(f) for f in d.glob("*.jsonl")) if c and slugify(c) == slug]
        known.update(cwds)
        path = max(set(cwds), key=cwds.count) if cwds else resolve_slug(slug, known)
        entry = project(path, slug)
        entry["slug"] = slug
        for f in sorted(d.rglob("*")):
            if f.is_file() and not f.is_symlink() and f.name not in SKIP_NAMES:
                rel = f.relative_to(d)
                kind = "memory" if rel.parts[0] == "memory" else "sessions"
                sub = rel.relative_to("memory") if kind == "memory" else rel
                entry["claude"].append((f, f"claude/{kind}/{sub}"))
    for f, cwd in codex:
        entry = project(cwd, None) if cwd else project(None, "codex-unknown-cwd")
        entry["codex"].append((f, "codex/" + str(f.relative_to(codex_home()))))

    for key, entry in projects.items():
        entry["git"] = {}
        if entry["path"] and Path(entry["path"]).is_dir():
            entry["git"] = git_facts(entry["path"])
            for f in local_project_files(entry["path"], entry["git"]):
                entry["files"].append((f, "files/" + f.name))

    if only:
        wanted = [str(Path(p).expanduser().resolve()) for p in only]
        projects = {k: v for k, v in projects.items()
                    if v["path"] and any(v["path"] == w or v["path"].startswith(w + "/") for w in wanted)}

    names = {}
    for key, entry in sorted(projects.items(), key=lambda kv: (kv[1]["path"] or "", kv[0])):
        name = display_name(entry["path"], entry["slug"])
        n, i = name, 2
        while n in names:
            n, i = f"{name}-{i}", i + 1
        names[n] = entry
        entry["name"] = n

    glob = []
    for profile, root in claude_roots():
        hist = root / "history.jsonl"
        if hist.is_file() and not hist.is_symlink():
            glob.append((hist, f"global/claude/{profile}/history.jsonl"))
        for sub in CLAUDE_GLOBAL_DIRS:
            d = root / sub
            if d.is_dir() and not d.is_symlink():
                for f in sorted(d.rglob("*")):
                    if f.is_file() and not f.is_symlink() and f.name not in SKIP_NAMES:
                        glob.append((f, f"global/claude/{profile}/{sub}/{f.relative_to(d)}"))
    for name in ("history.jsonl", "session_index.jsonl"):
        f = codex_home() / name
        if f.is_file():
            glob.append((f, f"global/codex/{name}"))
    mem = codex_home() / "memories"
    if mem.is_dir():
        glob += [(f, f"global/codex/memories/{f.relative_to(mem)}") for f in sorted(mem.rglob("*"))
                 if f.is_file() and f.name not in SKIP_NAMES]
    if only:
        glob = []  # a partial export brings only the named projects
    return names, glob


# ---------------------------------------------------------------- export

def copy_scanned(src, dst, rel, scanner, dry):
    """Copy src to dst line by line through the scanner. Returns (sha256, size)."""
    digest, size = hashlib.sha256(), 0
    binary = is_binary(src)
    out = None
    if not dry:
        dst.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        out = open(dst, "wb")
    try:
        with open(src, "rb") as fh:
            if binary:
                for chunk in iter(lambda: fh.read(1 << 20), b""):
                    digest.update(chunk)
                    size += len(chunk)
                    out and out.write(chunk)
            else:
                for n, line in enumerate(fh, 1):
                    if not line.endswith(b"\n") and src.suffix == ".jsonl":
                        try:  # a record still being written by a live session
                            json.loads(line)
                        except ValueError:
                            break
                    line = scanner.process(line, rel, n)
                    digest.update(line)
                    size += len(line)
                    out and out.write(line)
    finally:
        if out:
            out.close()
            os.chmod(dst, 0o600)
    return digest.hexdigest(), size


def cmd_export(args):
    names, glob = collect(args.project)
    if not args.dry_run:
        out = Path(args.out).expanduser().resolve()
        for forbidden in (home() / ".claude", codex_home(), home() / ".claude-profiles"):
            if is_within(out, forbidden):
                die(f"refusing to write the bundle inside {forbidden}")
        if is_within(out, REPO):
            if not is_within(out, EXPORTS):
                die(f"inside this repo a bundle may only go in {EXPORTS} (gitignored)")
            if not git_ignored(EXPORTS / "agent-state-probe"):
                die(f"{EXPORTS} is not gitignored; add `/exports/` to {REPO / '.gitignore'} first")
        stamp = dt.datetime.now().strftime("%Y%m%d-%H%M%S")
        bundle = out / f"agent-state-{stamp}"
        bundle.mkdir(parents=True, mode=0o700)
        os.chmod(bundle, 0o700)
    else:
        bundle = Path("/nonexistent")

    scanner = Scanner(redact=not args.no_redact)
    files, manifest_projects = {}, []
    total = 0

    def put(src, rel):
        nonlocal total
        sha, size = copy_scanned(src, bundle / rel, rel, scanner, args.dry_run)
        files[rel] = {"sha256": sha, "size": size}
        total += size

    for name, entry in sorted(names.items()):
        base = f"projects/{name}"
        for src, rel in entry["claude"] + entry["codex"] + entry["files"]:
            put(src, f"{base}/{rel}")
        info = {
            "name": name,
            "original_path": entry["path"],
            "claude_slug": entry["slug"],
            "claude_sessions": sum(1 for _, r in entry["claude"] if r.startswith("claude/sessions/") and r.count("/") == 2 and r.endswith(".jsonl")),
            "claude_memory_files": sum(1 for _, r in entry["claude"] if r.startswith("claude/memory/")),
            "codex_sessions": len(entry["codex"]),
            "local_files": [r for _, r in entry["files"]],
            "git": entry["git"],
        }
        manifest_projects.append(info)
        if not args.dry_run:
            (bundle / base).mkdir(parents=True, exist_ok=True, mode=0o700)
            (bundle / base / "project.json").write_text(json.dumps(info, indent=2) + "\n")
    for src, rel in glob:
        put(src, rel)

    manifest = {
        "format": FORMAT,
        "created": dt.datetime.now().astimezone().isoformat(timespec="seconds"),
        "source": {"home": str(home()), "codex_home": str(codex_home()), "host": socket.gethostname(),
                   "claude_profiles": [n for n, _ in claude_roots()]},
        "partial": bool(args.project),
        "redacted": not args.no_redact,
        "projects": manifest_projects,
        "files": files,
    }
    report = render_report(scanner.findings, manifest)
    summary(manifest, scanner.findings, total)
    if args.dry_run:
        print("\n(dry run: nothing written)")
        print(report_tail(scanner.findings))
        return
    (bundle / "MANIFEST.json").write_text(json.dumps(manifest, indent=1) + "\n")
    (bundle / "SECRETS-REPORT.txt").write_text(report)
    shutil.copy(REPO / "docs/agent-state-import.md", bundle / "README.md")
    for p in (bundle / "MANIFEST.json", bundle / "SECRETS-REPORT.txt", bundle / "README.md"):
        os.chmod(p, 0o600)
    print(f"\nbundle: {bundle}")
    print(report_tail(scanner.findings))
    print(f"next:   agent-state pack {bundle}     (encrypt before it leaves this machine)")


def render_report(findings, manifest):
    lines = ["Secret scan of this bundle. Values are never shown: file, line, detector, action.",
             "Rotate any real credential listed here; redacted copies are safe to move, the",
             "originals on the source machine are unchanged.", ""]
    lines += [f"{f}:{n}  {label}  [{action}]" for f, n, label, action in findings]
    if not findings:
        lines.append("No findings.")
    return "\n".join(lines) + "\n"


def report_tail(findings):
    review = sum(1 for f in findings if f[3].startswith("REVIEW"))
    redacted = len(findings) - review
    by = {}
    for _, _, label, _ in findings:
        by[label] = by.get(label, 0) + 1
    detail = ", ".join(f"{k}: {v}" for k, v in sorted(by.items())) or "none"
    return f"secrets: {redacted} redacted, {review} need review ({detail})"


def summary(manifest, findings, total):
    rows = manifest["projects"]
    print(f"{'project':58} {'claude':>6} {'memory':>6} {'codex':>5}  local files / git")
    for p in rows:
        g = p["git"]
        note = "no folder on disk" if not g else ("not a git repo" if not g.get("repo") else
               ("no remote" if not g.get("remote") else ("unpushed/dirty" if g.get("unpushed") or g.get("dirty") else "")))
        files = ",".join(Path(f).name for f in p["local_files"])
        print(f"{p['name'][:58]:58} {p['claude_sessions']:6} {p['claude_memory_files']:6} {p['codex_sessions']:5}  {files} {note}".rstrip())
    print(f"\n{len(rows)} projects, {len(manifest['files'])} files, {total / 1e9:.2f} GB")


# ---------------------------------------------------------------- verify

SAFE_PART = re.compile(r"^[^/\\\x00-\x1f\x7f]+$")  # one path component: no separators or controls
SLUG = re.compile(r"^[A-Za-z0-9-]+$")
PROFILE = re.compile(r"^[A-Za-z0-9._-]+$")


def safe_rel(rel):
    """A relative path that stays where it is put: no root, no `..`, no odd characters."""
    if not isinstance(rel, str) or not rel or rel.startswith("/"):
        return False
    parts = rel.split("/")
    return all(SAFE_PART.match(x) and x not in (".", "..") for x in parts)


def check_manifest(manifest):
    """Every reason this bundle must not be imported. A tampered MANIFEST.json can carry its own
    checksums, so verify() alone proves nothing about where files would land."""
    errors = []
    projects = {}
    files = manifest.get("files")
    if not isinstance(manifest.get("projects"), list) or not isinstance(files, dict) or not all(
            isinstance(m, dict) and isinstance(m.get("sha256"), str) for m in files.values()):
        return ["MANIFEST.json does not have the expected projects list and files table"]
    if not isinstance(manifest.get("source"), dict) or not isinstance(manifest["source"].get("home"), str):
        return ["MANIFEST.json has no source home folder"]
    for p in manifest["projects"]:
        if not isinstance(p, dict):
            errors.append("bad project entry")
            continue
        name, slug, orig = p.get("name"), p.get("claude_slug"), p.get("original_path")
        if not (isinstance(name, str) and SAFE_PART.match(name) and name not in (".", "..")):
            errors.append(f"bad project name: {name!r}")
            continue
        if not (isinstance(slug, str) and SLUG.match(slug)):
            errors.append(f"bad Claude project name for {name}")
        if orig is not None and not (isinstance(orig, str) and orig.startswith("/")
                                     and ".." not in orig.split("/")):
            errors.append(f"bad original path for {name}")
        projects[name] = p
    for rel in files:
        if not safe_rel(rel):
            errors.append(f"unsafe path: {rel!r}")
            continue
        parts = rel.split("/")
        if parts[0] == "projects" and len(parts) >= 4 and parts[1] in projects:
            kind = parts[2]
            ok = (kind == "claude" and len(parts) >= 5 and parts[3] in ("sessions", "memory")) \
                or (kind == "codex" and len(parts) >= 5 and parts[3] in CODEX_SESSION_DIRS) \
                or (kind == "files" and len(parts) == 4 and parts[3] in PROJECT_FILES)
        elif parts[0] == "global" and len(parts) >= 3 and parts[1] == "claude":
            ok = len(parts) >= 4 and PROFILE.match(parts[2]) and (
                parts[3:] == ["history.jsonl"] or (len(parts) >= 5 and parts[3] in CLAUDE_GLOBAL_DIRS))
        elif parts[0] == "global" and len(parts) >= 3 and parts[1] == "codex":
            ok = parts[2:] in (["history.jsonl"], ["session_index.jsonl"]) or \
                (len(parts) >= 4 and parts[2] == "memories")
        else:
            ok = False
        if not ok:
            errors.append(f"unexpected file: {rel!r}")
    return errors


def inside(path, root):
    """True when path, with every existing symlink resolved, stays under root."""
    real, base = os.path.realpath(path), os.path.realpath(root)
    return real == base or real.startswith(base.rstrip("/") + "/")


def load_bundle(path):
    bundle = Path(path).expanduser().resolve()
    m = bundle / "MANIFEST.json"
    if not m.is_file():
        die(f"{bundle} is not an agent-state bundle (no MANIFEST.json)")
    manifest = json.loads(m.read_text())
    if manifest.get("format") != FORMAT:
        die(f"bundle format {manifest.get('format')} is not supported by this version ({FORMAT})")
    errors = check_manifest(manifest)
    if errors:
        for e in errors[:20]:
            print("  " + e, file=sys.stderr)
        die(f"refusing this bundle: {len(errors)} problem(s) in MANIFEST.json (damaged or edited)")
    return bundle, manifest


def verify(bundle, manifest):
    bad = []
    for rel, meta in manifest["files"].items():
        f = bundle / rel
        if f.is_symlink() or not inside(f, bundle):
            bad.append(f"link     {rel}")
            continue
        if not f.is_file():
            bad.append(f"missing  {rel}")
            continue
        h = hashlib.sha256()
        with open(f, "rb") as fh:
            for chunk in iter(lambda: fh.read(1 << 20), b""):
                h.update(chunk)
        if h.hexdigest() != meta["sha256"]:
            bad.append(f"changed  {rel}")
    return bad


def cmd_verify(args):
    bundle, manifest = load_bundle(args.bundle)
    bad = verify(bundle, manifest)
    for b in bad:
        print(b)
    if bad:
        die(f"{len(bad)} file(s) failed verification")
    print(f"ok: {len(manifest['files'])} files match MANIFEST.json")


# ---------------------------------------------------------------- import

class Mapper:
    def __init__(self, old_home, rules):
        pairs = []
        for r in rules:
            if "=" not in r:
                die(f"--map expects OLD=NEW, got {r!r}")
            old, new = r.split("=", 1)
            pairs.append((old.rstrip("/"), str(Path(new).expanduser()).rstrip("/")))
        if old_home.rstrip("/") != str(home()).rstrip("/"):
            pairs.append((old_home.rstrip("/"), str(home()).rstrip("/")))
        self.pairs = sorted(pairs, key=lambda p: -len(p[0]))
        self.old_home, self.new_home = old_home, str(home())

    def path(self, p):
        if not p:
            return p
        for old, new in self.pairs:
            if p == old or p.startswith(old + "/"):
                return new + p[len(old):]
        return p

    def slug(self, original, slug):
        if original:
            new = self.path(original)
            return slug if new == original else slugify(new)
        old_s, new_s = slugify(self.old_home), slugify(self.new_home)
        return new_s + slug[len(old_s):] if slug.startswith(old_s + "-") else slug


def move_paths(value, mapper):
    """Return (value, changed) with every string that *is* a path under a mapped prefix moved.
    Working directories, workspace roots, sandbox entries and tool-call file paths are such
    values. Prose that only mentions a path ("cd /old/x && ls") is left exactly as written."""
    if isinstance(value, str):
        moved = mapper.path(value) if value.startswith("/") else value
        return moved, moved != value
    if isinstance(value, dict):
        changed = False
        for k, v in value.items():
            nv, c = move_paths(v, mapper)
            if c:
                value[k], changed = nv, True
        return value, changed
    if isinstance(value, list):
        changed = False
        for i, v in enumerate(value):
            nv, c = move_paths(v, mapper)
            if c:
                value[i], changed = nv, True
        return value, changed
    return value, False


def rewrite_line(line, mapper):
    """Re-point one JSONL record at the new folders; untouched lines keep their exact bytes."""
    if not mapper.pairs or not any(old.encode() in line for old, _ in mapper.pairs):
        return line
    try:
        rec = json.loads(line)
    except ValueError:
        return line
    rec, changed = move_paths(rec, mapper)
    if not changed:
        return line
    end = b"\n" if line.endswith(b"\n") else b""
    return json.dumps(rec, ensure_ascii=False, separators=(",", ":")).encode() + end


def transformed(src, mapper):
    """Stream a bundle file as it should land on this machine."""
    with open(src, "rb") as fh:
        if src.suffix != ".jsonl" or not mapper.pairs:
            yield from iter(lambda: fh.read(1 << 20), b"")
        else:
            for line in fh:
                yield rewrite_line(line, mapper)


def sha_of(chunks):
    h = hashlib.sha256()
    for c in chunks:
        h.update(c)
    return h.hexdigest()


def file_chunks(path):
    with open(path, "rb") as fh:
        yield from iter(lambda: fh.read(1 << 20), b"")


class Importer:
    def __init__(self, bundle, manifest, mapper, apply):
        self.bundle, self.manifest, self.mapper, self.apply = bundle, manifest, mapper, apply
        self.counts = {"new": 0, "same": 0, "conflict": 0, "merged": 0, "pending": 0, "refused": 0}
        self.notes = []
        self.backup = home() / ".local/share/agent-manager/backups" / ("state-import-" + dt.datetime.now().strftime("%Y%m%d-%H%M%S"))
        self.new_codex = 0

    def place(self, rel, dst, root):
        """Copy one bundle file to dst (which must stay under root) unless something is there."""
        src = self.bundle / rel
        if not inside(dst, root):
            self.counts["refused"] += 1
            self.notes.append(f"refused (would land outside {root}): {rel}")
            return False
        if dst.exists() or dst.is_symlink():
            if dst.is_file() and sha_of(file_chunks(dst)) == sha_of(transformed(src, self.mapper)):
                self.counts["same"] += 1
            else:
                self.counts["conflict"] += 1
                self.notes.append(f"kept existing (differs): {dst}")
            return False
        self.counts["new"] += 1
        if self.apply:
            dst.parent.mkdir(parents=True, exist_ok=True)
            tmp = dst.with_name(dst.name + ".agent-state-tmp")
            with open(tmp, "wb") as out:
                for chunk in transformed(src, self.mapper):
                    out.write(chunk)
            os.chmod(tmp, 0o600)
            os.replace(tmp, dst)
        return True

    def merge_lines(self, rel, dst, root, sort_key):
        """Union of history lines, ordered by time; the existing file is backed up first."""
        if not dst.exists() or not inside(dst, root):
            return self.place(rel, dst, root)
        incoming = b"".join(transformed(self.bundle / rel, self.mapper)).splitlines(keepends=True)
        existing = dst.read_bytes().splitlines(keepends=True)
        seen = {l.rstrip(b"\n") for l in existing}
        new = [l if l.endswith(b"\n") else l + b"\n" for l in incoming if l.rstrip(b"\n") not in seen]
        if not new:
            self.counts["same"] += 1
            return False
        lines = [l if l.endswith(b"\n") else l + b"\n" for l in existing] + new
        try:
            lines.sort(key=lambda l: json.loads(l).get(sort_key))
        except (ValueError, TypeError, AttributeError):
            pass  # unparseable or mixed records: keep existing order, new lines appended
        self.counts["merged"] += 1
        self.notes.append(f"merged {len(new)} line(s) into {dst}")
        if self.apply:
            self.backup_file(dst)
            tmp = dst.with_name(dst.name + ".agent-state-tmp")
            tmp.write_bytes(b"".join(lines))
            os.chmod(tmp, 0o600)
            os.replace(tmp, dst)
        return True

    def backup_file(self, path):
        target = self.backup / path.relative_to(home())
        target.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(path, target)

    def run(self):
        claude = home() / ".claude"
        for p in self.manifest["projects"]:
            base = f"projects/{p['name']}/"
            orig = p["original_path"]
            new_path = self.mapper.path(orig)
            slug = self.mapper.slug(orig, p["claude_slug"])
            if len(slug) > MAX_SLUG and slug != p["claude_slug"]:
                self.notes.append(f"skipped {p['name']}: new path too long for Claude's project naming")
                continue
            for rel in (r for r in self.manifest["files"] if r.startswith(base)):
                sub = rel[len(base):]
                target = claude / "projects" / slug
                if sub.startswith("claude/sessions/"):
                    self.place(rel, target / sub[len("claude/sessions/"):], target)
                elif sub.startswith("claude/memory/"):
                    self.place(rel, target / "memory" / sub[len("claude/memory/"):], target)
                elif sub.startswith("codex/"):
                    if self.place(rel, codex_home() / sub[len("codex/"):], codex_home()):
                        self.new_codex += 1
                elif sub.startswith("files/"):
                    if new_path and Path(new_path).is_dir():
                        self.place(rel, Path(new_path) / sub[len("files/"):], new_path)
                    else:
                        self.counts["pending"] += 1
                        self.notes.append(f"later: clone {new_path or p['name']}, then re-run import for {sub[6:]}")
        for rel in self.manifest["files"]:
            if not rel.startswith("global/"):
                continue
            parts = rel.split("/")
            if parts[1] == "claude":
                profile, sub = parts[2], "/".join(parts[3:])
                root = claude if profile == "main" else home() / ".claude-profiles" / profile
                if profile != "main" and not root.is_dir():  # main is ~/.claude itself, created as needed
                    self.counts["pending"] += 1
                    self.notes.append(f"later: run `claude-account add {profile}`, then re-run import")
                    continue
                dst = root / sub
                if sub == "history.jsonl":
                    if dst.is_symlink():  # a profile sharing the primary history file
                        dst = dst.resolve()
                        self.merge_lines(rel, dst, dst.parent, "timestamp")
                    else:
                        self.merge_lines(rel, dst, root, "timestamp")
                else:
                    self.place(rel, dst, root)
            elif parts[1] == "codex":
                sub = "/".join(parts[2:])
                key = {"history.jsonl": "ts", "session_index.jsonl": "updated_at"}.get(sub)
                if key:
                    self.merge_lines(rel, codex_home() / sub, codex_home(), key)
                else:
                    self.place(rel, codex_home() / sub, codex_home())


def codex_running():
    r = subprocess.run(["pgrep", "-x", "codex"], capture_output=True)
    return r.returncode == 0


def cmd_import(args):
    bundle, manifest = load_bundle(args.bundle)
    bad = verify(bundle, manifest)
    if bad:
        die(f"bundle failed verification ({len(bad)} file(s)); run `agent-state verify {bundle}`")
    if args.reindex_codex and args.apply and codex_running():  # refuse before writing anything
        die("quit Codex (CLI, app and IDE extension) before --reindex-codex")
    mapper = Mapper(manifest["source"]["home"], args.map or [])
    imp = Importer(bundle, manifest, mapper, args.apply)
    imp.run()

    print(f"bundle:  {bundle}  (from {manifest['source']['host']}, {manifest['created']})")
    for old, new in mapper.pairs:
        print(f"paths:   {old}  ->  {new}")
    c = imp.counts
    print(f"files:   {c['new']} new, {c['same']} already present, {c['conflict']} kept (existing differs), "
          f"{c['merged']} history merges, {c['pending']} waiting, {c['refused']} refused")
    seen = set()
    for n in imp.notes:
        if n not in seen:
            print("  " + n)
            seen.add(n)

    # The index may predate files placed by this run or by an earlier one, so an explicit
    # --reindex-codex always rebuilds it; the warning only fires when this run added sessions.
    states = sorted(codex_home().glob("state_*.sqlite*"))
    if states and args.reindex_codex and args.apply:
        target = imp.backup / "codex-state"
        target.mkdir(parents=True, exist_ok=True)
        for f in states:
            shutil.move(str(f), target / f.name)
        print(f"codex:   index moved to {target}; Codex rebuilds it from the sessions on next start")
    elif states and imp.new_codex:
        print("codex:   Codex already ran on this machine, so it will not list the imported sessions")
        print("         until its index is rebuilt. Quit Codex and re-run with --apply --reindex-codex.")
    if not args.apply:
        print("\npreview only. Run again with --apply to write.")
    elif imp.backup.exists():
        print(f"backups: {imp.backup}")


# ---------------------------------------------------------------- pack

def cmd_pack(args):
    bundle, manifest = load_bundle(args.bundle)
    if verify(bundle, manifest):
        die("bundle failed verification; re-export it")
    out = bundle.with_suffix(".dmg")
    if out.exists():
        die(f"{out} already exists")
    if sys.platform != "darwin":
        print("Not macOS. Encrypt it with:")
        print(f"  tar -C {bundle.parent} -czf - {bundle.name} | openssl enc -aes-256-cbc -pbkdf2 -salt -out {bundle}.tgz.enc")
        print(f"and on the other machine:  openssl enc -d -aes-256-cbc -pbkdf2 -in {bundle.name}.tgz.enc | tar -xzf -")
        return
    print("hdiutil will ask for a new password. Keep it somewhere safe (a password manager).")
    r = subprocess.run(["hdiutil", "create", "-encryption", "AES-256", "-format", "ULFO",
                        "-volname", bundle.name, "-srcfolder", str(bundle), str(out)])
    if r.returncode:
        die("hdiutil failed; nothing was removed")
    os.chmod(out, 0o600)
    print(f"\nencrypted: {out}")
    print(f"after copying it and checking it opens on the new machine, delete the plain folder: {bundle}")


def main():
    ap = argparse.ArgumentParser(prog="agent-state", description=__doc__.split("\n")[0])
    sub = ap.add_subparsers(dest="cmd", required=True)
    e = sub.add_parser("export", help="write a bundle of conversations and memory")
    e.add_argument("--out", default=str(EXPORTS), help=f"parent folder (default: {EXPORTS})")
    e.add_argument("--project", action="append", help="only this project path (repeatable)")
    e.add_argument("--dry-run", action="store_true", help="scan and list, write nothing")
    e.add_argument("--no-redact", action="store_true", help="keep detected secrets (report only)")
    v = sub.add_parser("verify", help="check a bundle against its MANIFEST.json")
    v.add_argument("bundle")
    i = sub.add_parser("import", help="place a bundle into this machine's agent folders")
    i.add_argument("bundle")
    i.add_argument("--apply", action="store_true", help="write (default is a preview)")
    i.add_argument("--map", action="append", metavar="OLD=NEW", help="move projects found under OLD to NEW")
    i.add_argument("--reindex-codex", action="store_true", help="let Codex rebuild its session index")
    p = sub.add_parser("pack", help="encrypt a bundle for transfer")
    p.add_argument("bundle")
    args = ap.parse_args()
    {"export": cmd_export, "verify": cmd_verify, "import": cmd_import, "pack": cmd_pack}[args.cmd](args)


if __name__ == "__main__":
    main()
