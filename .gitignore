# --- secrets: never commit ---
secrets.env
*.local.json
*.local.env

# --- rendered-from-template config (holds real tokens) ---
config/mode-configs/glm.json
config/mode-configs/glm-2.json

# --- macOS / python noise ---
.DS_Store
__pycache__/
*.pyc
*.pyo

# --- editor ---
*.swp
.idea/
.vscode/

# --- local skill development/evaluation workspaces ---
/skills/*-workspace/

# --- skill-editor soft deletes: timestamped buckets of removed content, never ours to keep ---
/skills/.trash/

# --- agent-state bundles: private conversations, never committed ---
# `agent-state export` writes to exports/ by default and refuses any other folder in this repo,
# or exports/ itself if this rule is removed. The rest catch a bundle or .dmg copied elsewhere.
/exports/
agent-state-*/
*.dmg
